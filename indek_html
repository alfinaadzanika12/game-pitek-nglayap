<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pitek Nglayap - Single Web Game</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            background: #2c3e50;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            overflow: hidden;
            color: white;
        }
        h1 {
            margin-bottom: 10px;
            font-size: 28px;
            text-shadow: 2px 2px #000;
        }
        p {
            margin-bottom: 15px;
            font-size: 14px;
            color: #bdc3c7;
        }
        #gameContainer {
            position: relative;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            border-radius: 8px;
            overflow: hidden;
        }
        canvas {
            background: linear-gradient(to bottom, #87CEEB, #E0F6FF);
            display: block;
        }
        .ui-layer {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background: rgba(0, 0, 0, 0.6);
            transition: opacity 0.3s ease;
        }
        .hidden {
            display: none !important;
        }
        .btn {
            background: #e67e22;
            color: white;
            border: none;
            padding: 12px 30px;
            font-size: 18px;
            font-weight: bold;
            border-radius: 25px;
            cursor: pointer;
            box-shadow: 0 5px #d35400;
            margin-top: 15px;
        }
        .btn:active {
            box-shadow: 0 2px #d35400;
            transform: translateY(3px);
        }
        .game-over-text {
            color: #e74c3c;
            font-size: 36px;
            font-weight: bold;
            text-shadow: 2px 2px #000;
        }
    </style>
</head>
<body>

    <h1>🐔 PITEK NGLAYAP 🐔</h1>
    <p>Tekan <strong>SPASI</strong> atau <strong>TAP LAYAR</strong> untuk melompat!</p>

    <div id="gameContainer">
        <canvas id="gameCanvas" width="800" height="400"></canvas>
        
        <div id="menuOverlay" class="ui-layer">
            <h2 id="menuTitle" style="font-size: 32px; text-shadow: 2px 2px #000;">Piteknya Siap Nglayap!</h2>
            <p id="menuSub" style="margin-top: 5px;">Jangan sampai ketangkap Emak atau nabrak batu kampung.</p>
            <button class="btn" id="startBtn">Mulai Nglayap</button>
        </div>
    </div>

<script>
    const canvas = document.getElementById("gameCanvas");
    const ctx = canvas.getContext("2d");
    const menuOverlay = document.getElementById("menuOverlay");
    const menuTitle = document.getElementById("menuTitle");
    const menuSub = document.getElementById("menuSub");
    const startBtn = document.getElementById("startBtn");

    // Game Variables
    let gameState = "START"; // START, PLAYING, GAMEOVER
    let score = 0;
    let highScore = localStorage.getItem("pitekHighScore") || 0;

    // Physics
    const gravity = 0.6;
    
    // Objek Pitek (Ayam)
    const pitek = {
        x: 100,
        y: 200,
        width: 40,
        height: 40,
        velocity: 0,
        jumpForce: -12,
        groundY: canvas.height - 90, // batas tanah
        draw() {
            // Badan Ayam (Oranye)
            ctx.fillStyle = "#ff9f43";
            ctx.fillRect(this.x, this.y, this.width, this.height);
            
            // Jengger (Merah)
            ctx.fillStyle = "#ff4d4d";
            ctx.fillRect(this.x + 25, this.y - 10, 12, 10);
            
            // Paruh (Kuning)
            ctx.fillStyle = "#feca57";
            ctx.fillRect(this.x + 40, this.y + 10, 8, 8);
            
            // Mata
            ctx.fillStyle = "#000000";
            ctx.fillRect(this.x + 30, this.y + 8, 4, 4);
        },
        update() {
            this.velocity += gravity;
            this.y += this.velocity;

            // Batasi agar tidak menembus tanah
            if (this.y >= this.groundY) {
                this.y = this.groundY;
                this.velocity = 0;
            }
        },
        jump() {
            if (this.y === this.groundY) {
                this.velocity = this.jumpForce;
            }
        }
    };

    // Objek Rintangan (Batu / Sapu Emak)
    let obstacles = [];
    let obstacleTimer = 0;
    let gameSpeed = 6;

    function spawnObstacle() {
        let type = Math.random() > 0.4 ? "batu" : "sapu";
        let height = type === "batu" ? Math.random() * 30 + 30 : 30; // tinggi bervariasi
        let yPos = type === "batu" ? canvas.height - 50 - height : canvas.height - 150; // sapu melayang

        obstacles.push({
            x: canvas.width,
            y: yPos,
            width: 30,
            height: height,
            type: type,
            passed: false
        });
    }

    // Reset Game
    function resetGame() {
        score = 0;
        gameSpeed = 6;
        obstacles = [];
        pitek.y = pitek.groundY;
        pitek.velocity = 0;
        obstacleTimer = 0;
    }

    // Input Handler (Spasi & Klik/Sentuh)
    window.addEventListener("keydown", (e) => {
        if (e.code === "Space") {
            if (gameState === "PLAYING") pitek.jump();
            else if (gameState === "GAMEOVER" || gameState === "START") handleButtonClick();
        }
    });

    canvas.addEventListener("touchstart", (e) => {
        e.preventDefault();
        if (gameState === "PLAYING") pitek.jump();
    });
    
    canvas.addEventListener("mousedown", () => {
        if (gameState === "PLAYING") pitek.jump();
    });

    function handleButtonClick() {
        resetGame();
        gameState = "PLAYING";
        menuOverlay.classList.add("hidden");
    }
    startBtn.addEventListener("click", handleButtonClick);

    // Loop Utama Game
    function animate() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        // 1. Gambar Tanah & Rumput Kampung
        ctx.fillStyle = "#2ed573"; // Rumput
        ctx.fillRect(0, canvas.height - 50, canvas.width, 50);
        ctx.fillStyle = "#ffa502"; // Jalan tanah bawah rumput
        ctx.fillRect(0, canvas.height - 15, canvas.width, 15);

        if (gameState === "PLAYING") {
            // Update & Gambar Pitek
            pitek.update();
            pitek.draw();

            // Handle Rintangan
            obstacleTimer++;
            if (obstacleTimer % 90 === 0) { // Spawn tiap beberapa detik sekali
                spawnObstacle();
            }

            // Atur tingkat kesulitan berdasarkan skor
            gameSpeed = 6 + Math.floor(score / 50);

            for (let i = obstacles.length - 1; i >= 0; i--) {
                let obs = obstacles[i];
                obs.x -= gameSpeed;

                // Warna rintangan
                if (obs.type === "batu") {
                    ctx.fillStyle = "#747d8c"; // Batu Abu-abu
                } else {
                    ctx.fillStyle = "#d63031"; // Sapu Emak Merah Marah
                }
                ctx.fillRect(obs.x, obs.y, obs.width, obs.height);

                // Hitung Skor jika lolos
                if (!obs.passed && obs.x + obs.width < pitek.x) {
                    score += 10;
                    obs.passed = true;
                    if (score > highScore) {
                        highScore = score;
                        localStorage.setItem("pitekHighScore", highScore);
                    }
                }

                // Cek Tabrakan (AABB Collision)
                if (
                    pitek.x < obs.x + obs.width &&
                    pitek.x + pitek.width > obs.x &&
                    pitek.y < obs.y + obs.height &&
                    pitek.y + pitek.height > obs.y
                ) {
                    // Pitek Menabrak! Game Over
                    gameState = "GAMEOVER";
                    menuTitle.innerHTML = "<span class='game-over-text'>PITEK KETANGKEP EMAL!</span>";
                    menuSub.innerHTML = `Skor Kamu: <strong>${score}</strong> | Rekor Terbaik: <strong>${highScore}</strong>`;
                    startBtn.innerText = "Nglayap Lagi";
                    menuOverlay.classList.remove("hidden");
                }

                // Hapus rintangan yang keluar layar
                if (obs.x + obs.width < 0) {
                    obstacles.splice(i, 1);
                }
            }

            // Tampilkan Skor Real-time di Pojok Kiri Atas
            ctx.fillStyle = "#000000";
            ctx.font = "bold 20px Arial";
            ctx.fillText(`Skor: ${score}`, 20, 35);
            ctx.font = "16px Arial";
            ctx.fillText(`Rekor: ${highScore}`, 20, 60);

        } else {
            // Jika sedang tidak main (Menu awal/game over), pitek tetap digambar statis
            pitek.draw();
        }

        requestAnimationFrame(animate);
    }

    // Jalankan animasi pertama kali
    animate();
</script>

</body>
</html>
